# --- Сервер ---
YEELIGHT_SERVER_HOST=127.0.0.1
YEELIGHT_SERVER_PORT=8000
YEELIGHT_SERVER_DB=data/server.db
YEELIGHT_SERVER_ADMIN_USER=admin
# Пароль нужен только при создании первого пользователя.
# tools/setup.bat сгенерирует его автоматически.
YEELIGHT_SERVER_ADMIN_PASSWORD=
YEELIGHT_SERVER_SESSION_TTL_SECONDS=43200
YEELIGHT_SERVER_SECURE_COOKIES=false
YEELIGHT_SERVER_TLS_CERT=
YEELIGHT_SERVER_TLS_KEY=
YEELIGHT_SERVER_COMMAND_TIMEOUT_SECONDS=15
YEELIGHT_SERVER_MAX_COMMAND_WAIT_SECONDS=30
YEELIGHT_SERVER_HEARTBEAT_SECONDS=20
YEELIGHT_SERVER_MANAGER_GRACE_SECONDS=45
YEELIGHT_SERVER_LEGACY_MODES_FILE=data/modes.json

# --- Менеджер ---
YEELIGHT_SERVER_URL=http://127.0.0.1:8000
# По умолчанию используется имя компьютера.
YEELIGHT_MANAGER_NAME=
# Пустое значение = системный каталог пользователя.
YEELIGHT_MANAGER_HOME=
YEELIGHT_MANAGER_LOCAL_API=true
YEELIGHT_MANAGER_LOCAL_HOST=127.0.0.1
YEELIGHT_MANAGER_LOCAL_PORT=8765
YEELIGHT_MANAGER_UI=true
YEELIGHT_MANAGER_POLL_SECONDS=30
YEELIGHT_MANAGER_DISCOVERY_TIMEOUT_SECONDS=2
YEELIGHT_MANAGER_COMMAND_TIMEOUT_SECONDS=30
YEELIGHT_MANAGER_VERIFY_TLS=true
YEELIGHT_MANAGER_LOG_LEVEL=INFO
